class Monster:
    def __init__(self, name: str, hp: int, dmg: int):
        self.name = name
        self.hp = hp
        self.dmg = dmg

    def show_info(self):
        print(self.name)
        print(f"❤️: {self.hp}")
        print(f"⚔️: {self.dmg}")

gargoyle = Monster("Горгулья", 120, 18)

gargoyle.show_info()
