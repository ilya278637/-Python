class Weapon:
    def __init__(self, name):
        self.name = name

    def use(self, monster):
        pass


class SilverSword(Weapon):
    def __init__(self):
        super().__init__("Серебряный меч")

    def use(self, monster):
        damage = 30
        print(f"Ван Хельсинг атакует {monster.get_name()} серебряным мечом! Урон: {damage}")
        monster.take_damage(damage)


