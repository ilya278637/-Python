class Hunter:
    def __init__(self, name):
        self.__name = name
        self.__hp = 100
        self.__weapons = []

    def get_name(self):
        return self.__name

    def get_hp(self):
        return self.__hp

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0
        else:
            self.__hp = value

    def add_weapon(self, weapon):
        self.__weapons.append(weapon)

    def show_inventory(self):
        print("Инвентарь охотника:")
        for i, weapon in enumerate(self.__weapons):
            print(f"{i + 1}. {weapon.name}")

    def attack(self, weapon_index, monster):
        if 0 <= weapon_index < len(self.__weapons):
            weapon = self.__weapons[weapon_index]
            weapon.use(monster)
        else:
            print("Неверный выбор оружия!")

    def is_alive(self):
        return self.__hp > 0
