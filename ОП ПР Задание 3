class Monster:

    def __init__(self, name: str, power: int, hp: int):
        self.name = name
        self.power = power
        self.hp = hp

    def mutate(self):
        self.power += 5
        print(f"{self.name} мутирует! Сила увеличена!")
        print(f"⚔️: {self.power}")

    def rest(self):
        self.hp += 10
        print(f"{self.name} отдыхает в склепе! Здоровье восстановлено!")
        print(f"❤️: {self.hp}")

lycan = Monster(name="Люкан", power=15, hp=90)

lycan.mutate()
lycan.rest()
