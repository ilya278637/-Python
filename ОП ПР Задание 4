class Zombie:

    def __init__(self, name: str, hp: int):
        self.name = name
        self.hp = hp

    def bite(self, damage: int) -> int:
        self.hp -= damage
        return self.hp

butcher = Zombie(name="Мясник", hp=100)

damage_input = int(input("Введите силу укуса: "))

remaining_hp = butcher.bite(damage_input)

print(f"Остаток здоровья: {remaining_hp}")
